# Backend environment variables (names only - never commit real values)
APP_ENV=development
DATABASE_URL=sqlite:///./app.db
JWT_SECRET=                 # REQUIRED for any shared deployment: a long random string (32+ bytes)
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:5173   # comma-separated; not needed when the API serves the frontend itself
SEED_DEMO_DATA=true         # set false in any real environment
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=60
# AI order capture (optional). Without a key the app uses the rule-based fallback and says so in the UI.
LLM_PROVIDER=none           # none | openai (any OpenAI-compatible API) | anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=               # optional, for OpenAI-compatible gateways
LLM_TIMEOUT_SECONDS=12
# Optional
FRONTEND_DIST=              # path to frontend/dist if not in the default location
